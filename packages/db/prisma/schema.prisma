generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        Event[]
  integrations  Integration[]
  subscriptions Subscription[]
  notifications Notification[]
  settings      Setting[]
  briefings     Briefing[]
  videoStates   UserVideoState[]
  devices       Device[]
  screenEvents  ScreenEvent[]
  focusSessions FocusSession[]
  habits        Habit[]
  habitLogs     HabitLog[]
  dayTasks      DayTask[]
  sleepLogs     SleepLog[]
}

model Device {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  type       String   @default("desktop") // desktop | mobile | tablet
  os         String?
  token      String   @unique
  userId     String   @db.Uuid
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  screenEvents ScreenEvent[]
  focusSessions FocusSession[]

  @@index([userId])
}

model ScreenEvent {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @db.Uuid
  userId    String   @db.Uuid
  timestamp DateTime
  duration  Int      // seconds
  app       String
  title     String?
  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([deviceId, timestamp])
  @@index([userId, timestamp])
}

model Event {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  timestamp DateTime @default(now())
  source    String
  payload   Json
  userId    String   @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
  @@index([type])
}

model Integration {
  id        String   @id @default(uuid()) @db.Uuid
  service   String
  enabled   Boolean  @default(true)
  config    Json?
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, service])
}

model Subscription {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  cost          Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD")
  billingCycle  String   @default("monthly")
  nextPaymentAt DateTime
  category      String?
  notes         String?
  userId        String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, nextPaymentAt])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt])
}

model Setting {
  id    String @id @default(uuid()) @db.Uuid
  key   String
  value Json
  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
}

model UserVideoState {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  videoId   String
  watched   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, videoId])
  @@index([userId, videoId, watched])
}

model Briefing {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   // "morning" or "evening"
  content   Json
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type, createdAt])
}

model Habit {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  emoji     String   @default("✅")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  logs HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(uuid()) @db.Uuid
  habitId   String   @db.Uuid
  userId    String   @db.Uuid
  day       String // YYYY-MM-DD (local)
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([habitId, day])
  @@index([userId, day])
}

model DayTask {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  day       String // YYYY-MM-DD (local)
  text      String
  done      Boolean  @default(false)
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, day])
}

model SleepLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  day       String // YYYY-MM-DD (night = wake date, local)
  bedAt     String // "HH:MM"
  wakeAt    String // "HH:MM"
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, day])
  @@index([userId, day])
}

model FocusSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  deviceId  String   @db.Uuid
  startedAt DateTime @default(now())
  endsAt    DateTime
  endedAt   DateTime?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([deviceId, endedAt])
}
